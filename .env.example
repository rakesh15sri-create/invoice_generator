# Copy this file to ".env" and adjust. Restart the app after changing it.

# MongoDB connection. Local MongoDB by default.
# For MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=invoice_generator

# Port the app runs on.
PORT=3001

# ImageKit file storage (invoice PDFs, attachments, company logos). Files are uploaded as private.
# Find these in ImageKit: Developer options → API keys / URL endpoint. Keep the private key secret.
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_FOLDER=/invoice-generator

# Set to "none" to stop the browser opening automatically on start.
# BROWSER=none
